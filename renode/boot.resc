# Create the Renode machine and its UART PTY. The controller copies the exact
# input flash to /tmp/ota-flash.bin before launch, sets FAULT_AFTER_OPERATION,
# and uses CLI -e commands to begin tracing and start emulation.

emulation CreateUartPtyTerminal "mcumgr_term" "/tmp/mcumgr-uart"
mach create "ota"
machine LoadPlatformDescription @/workspace/app/renode/platform.repl
connector Connect sysbus.uart0 mcumgr_term
sysbus.flash LoadFlash @/tmp/ota-flash.bin
