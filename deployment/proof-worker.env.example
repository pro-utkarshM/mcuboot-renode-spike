# Copy to a host-local mode-0600 file and replace every REQUIRED value.
PROOF_ROOT=/srv/ota-proof
PROOF_REPO=/opt/ota-proof/repo
PROOF_MANIFEST=/srv/ota-proof/control/manifest.json
PROOF_LINEAGES_DIR=/srv/ota-proof/control/lineages

PROOF_WORKER_ID=REQUIRED_WORKER_ID
PROOF_WORKER_ARCH=REQUIRED_ARCHITECTURE
PROOF_BUILD_IDENTITY=REQUIRED_RENODE_BUILD_IDENTITY
PROOF_EXECUTOR_ID=REQUIRED_ARCHITECTURE_EXECUTOR_ID
PROOF_WORKER_JOBS=1
PROOF_REQUIRE_QUALIFICATION=1
PROOF_QUALIFICATION_RESULT=/srv/ota-proof/qualification/worker.json

PROOF_CONTAINER_RUNTIME=docker
PROOF_RUNTIME_IMAGE=REQUIRED_PINNED_IMAGE_REFERENCE
PROOF_RUNTIME_IMAGE_ID=REQUIRED_LOCAL_IMAGE_ID
PROOF_RUNTIME_ARCH=amd64
PROOF_RUNTIME_ARCHIVE=/path/to/frozen-runtime-image.tar
PROOF_RUNTIME_ARCHIVE_SHA256=REQUIRED_SHA256
PROOF_CONTROL_BUNDLE=/path/to/frozen-control-bundle.tar
PROOF_CONTROL_BUNDLE_SHA256=REQUIRED_SHA256
PROOF_REQUIRE_NO_DEFAULT_ROUTE=1

PROOF_CHECKPOINT_PROGRAM=/opt/ota-proof/bin/generate-local-checkpoints
PROOF_QUALIFICATION_SHARDS=/srv/ota-proof/shards/qualification
PROOF_QUALIFICATION_READY=/srv/ota-proof/shards/qualification-ready
PROOF_REFERENCE_RESULTS=/srv/ota-proof/qualification/x86-reference
PROOF_CANDIDATE_RESULTS=/srv/ota-proof/qualification/worker-candidate
PROOF_REFERENCE_WORKER_ID=proof-x86
PROOF_QUALIFICATION_REPETITION=1
PROOF_QUALIFICATION_CUTS=1,4321,9000,10163,10164,10165,10166,15355,30695,30709

# The harness receives {phase}, {workers}, {sample}, and {output}. It must run
# representative sealed cases and write <output>/metrics.json.
PROOF_BENCHMARK_HARNESS=/opt/ota-proof/bin/benchmark-harness --phase {phase} --workers {workers} --output {output}
PROOF_BENCHMARK_SAMPLES=3

# x86 control-node settings for the direct-link Pi.
PROOF_PI_HOST=10.42.0.2
PROOF_PI_USER=REQUIRED_PI_USER
PROOF_PI_WORKER_ID=proof-pi
PROOF_PI_ROOT=/srv/ota-proof
PROOF_PI_REPO=/opt/ota-proof/repo
PROOF_PI_CONFIG=/etc/ota-proof/worker.env
PROOF_SSH_KEY=/home/REQUIRED_X86_USER/.ssh/proof_pi_ed25519

# x86 only: existing baseline/negative/fixture/fault-hook/unprivileged gate tree.
PROOF_FINALIZATION_ARTIFACTS=/srv/ota-proof/finalization-artifacts
